# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------
# Optio build artefacts.
#
# The datasets and the fitted models are regenerated by
#   python train_optio.py     and     python train_deep.py
# They are large (~55 MB) third-party or derived data, so they are
# fetched and built locally rather than vendored into git.
#
# The database holds real account records and is never committed.
# ---------------------------------------------------------------
Optio/data/
Optio/model/**/*.joblib
Optio/model/**/*.npz
Optio/model/**/*.png
!Optio/model/**/metrics.json
!Optio/model/**/.gitkeep

# Never commit accounts or session history
*.db
*.db-wal
*.db-shm

# Node (only if tooling is added later)
node_modules/
npm-debug.log*
